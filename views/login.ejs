<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - CHATRIX</title>
    <link rel="stylesheet" href="/CSS/style.css">
</head>

<body class="auth-page">
    <main class="auth-wrap">
        <section class="auth-card">
            <div class="auth-brand">
                <span class="auth-logo">💬</span>
                <span class="auth-name">CHATRIX</span>
            </div>

            <header class="auth-header">
                <h1 class="auth-title">Welcome back</h1>
                <p class="auth-subtitle">Log in to continue to your dashboard</p>
            </header>

            <% if (username) { %>
                <p id="welcomeMessage" class="welcome-banner">Welcome, <%= username %>! Log in below.</p>
            <% } %>

            <p id="message" class="form-message <%= error ? 'is-error' : '' %>" role="alert" aria-live="polite"><%= error %></p>

            <form action="/login" method="post" novalidate>
                <div class="field">
                    <label class="field-label" for="email">Email</label>
                    <div class="input-wrap">
                        <span class="input-icon" aria-hidden="true">✉️</span>
                        <input class="field-input" id="email" name="email" type="email" placeholder="you@example.com" autocomplete="email" required>
                    </div>
                    <span class="field-error" id="email-error"></span>
                </div>

                <div class="field">
                    <label class="field-label" for="password">Password</label>
                    <div class="input-wrap">
                        <span class="input-icon" aria-hidden="true">🔒</span>
                        <input class="field-input" id="password" name="password" type="password" placeholder="Enter your password" autocomplete="current-password" required>
                        <button type="button" class="toggle-password" data-target="password" aria-label="Show password">👁️</button>
                    </div>
                    <span class="field-error" id="password-error"></span>
                </div>

                <div class="auth-actions">
                    <button id="loginBtn" type="submit" class="btn-block">Log in</button>
                </div>
            </form>

            <footer class="auth-footer">
                <span>Don't have an account?</span>
                <a class="auth-link" href="/signup">Sign up</a>
                <span class="auth-sep">·</span>
                <a class="auth-link" href="/">Home</a>
                <span class="auth-sep">·</span>
                <a class="auth-link" href="/about">About</a>
            </footer>
        </section>
    </main>

    <script src="/JS/script.js"></script>
</body>

</html>
